# ANTHROPIC_API_KEY: Required. Powers the AI writing coach through the
# Anthropic Claude Messages API.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_WORKSPACE_ID: Required ONLY if your API key is identity-linked
# (the API then returns "anthropic-workspace-id is required"). Find the
# workspace id (wrkspc_...) in the Anthropic Console under Settings ->
# Workspaces, or on the page of the API key itself.
# ANTHROPIC_WORKSPACE_ID="wrkspc_xxxxxxxxxxxx"

# Optional: override the Claude model used by the coach.
# CLAUDE_MODEL="claude-opus-5"   # pricier, slightly stronger coaching

# ---------------------------------------------------------------------------
# Accounts, subscriptions and free-tier metering (all optional).
# Leave these unset and the app runs anonymously and locally, exactly as it
# did before accounts existed. Set them to switch each piece on.
# ---------------------------------------------------------------------------

# DATABASE_URL: Postgres. Switches on server-side free-piece metering, and is
# required by everything else below. Neon, Supabase and Vercel Postgres all work;
# the tables are created automatically on first use.
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# RESEND_API_KEY / EMAIL_FROM: sign-in emails (magic links). With DATABASE_URL
# set, these switch on parent accounts. The from-address domain must be verified
# in Resend; resend.dev works for testing.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Maple Writing Coach <hello@yourdomain.ca>"

# Stripe: subscriptions. Create two recurring prices (monthly and yearly) in the
# Stripe dashboard and paste their price IDs here.
# STRIPE_SECRET_KEY="sk_live_..."          # sk_test_... while testing
# STRIPE_PRICE_MONTHLY="price_..."
# STRIPE_PRICE_YEARLY="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."        # from the webhook endpoint you add

# PRO_UNLOCK_CODES: comma-separated codes that unlock the full app without
# paying — your own access, teachers, beta families. Verified server-side and
# never sent to the browser, so they can't be found by reading the page.
#
# This is the ONLY paid-tier switch that needs nothing else configured: no
# database, no email, no Stripe. Redeeming sets a signed year-long cookie.
# Editing or removing a code revokes every pass issued under it.
# PRO_UNLOCK_CODES="MAPLE-ADMIN-XXXXX-XXXXX-XXXXX,MAPLE-TEACH-XXXXX-XXXXX-XXXXX"

# UNLOCK_SECRET (optional): extra salt for the pass signature. Changing it
# revokes every pass while leaving the codes themselves working.
# UNLOCK_SECRET="any-long-random-string"

# DEMO_MODE: show the whole app, unmetered, with every trace of money removed —
# no credit counter, no paywall, no upgrade prompts, no unlock box, and the
# billing endpoints answering 404. For showing the platform to a teacher or a
# school without a price tag in the room.
# Unset it (or set it to 0) and redeploy to put everything back.
# DEMO_MODE="1"
